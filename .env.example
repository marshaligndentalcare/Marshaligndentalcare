# ─────────────────────────────────────────────────────────────
# Marshalign Dental Care — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# NEVER commit real credentials, passwords, or private API keys to Git.
# Copy this file to .env.local for local development.
# In Vite, variables prefixed with VITE_ are exposed to the client bundle.
# ─────────────────────────────────────────────────────────────

# ── Canonical site URL ────────────────────────────────────────────────────────
# Used for canonical links, og:url, og:image, twitter:image, sitemap, and
# JSON-LD. Must end WITHOUT a trailing slash.
# Production value: https://marshaligndentalcare.in
VITE_SITE_URL=https://marshaligndentalcare.in

# ── Search-engine indexing switch ─────────────────────────────────────────────
# Set to "false" (the default) during staging / pre-launch.
# When false: index.html emits <meta name="robots" content="noindex,nofollow">
#             and robots.txt serves "Disallow: /".
# Set to "true" only at production launch (flip in Cloudflare Pages env vars).
# Never set to "true" on *.pages.dev preview deployments.
VITE_SITE_INDEXABLE=false

# ── Clinic WhatsApp Enquiry Phone ─────────────────────────────────────────────
# Public identifier — numbers only with country code (no + sign).
VITE_WA_PHONE=919025655627

# ── Optional: Google Analytics / Tag Manager Measurement ID ──────────────────
# (Public Client ID — safe to expose in browser bundle)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Optional: Google Maps JavaScript API Key ──────────────────────────────────
# If switching from embed iframe to Maps JS SDK.
# Restrict this key in Google Cloud Console by HTTP referrer:
#   marshaligndentalcare.in/*
# VITE_GOOGLE_MAPS_API_KEY=your_restricted_maps_api_key_here
