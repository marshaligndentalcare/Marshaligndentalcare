# ─────────────────────────────────────────────────────────────
# Marshalign Dental Care — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# NEVER commit real credentials, passwords, or private API keys to Git.
# Copy this file to .env.local for local development.
# In Vite, variables prefixed with VITE_ are exposed to the client bundle.
# ─────────────────────────────────────────────────────────────

# Canonical site URL
VITE_SITE_URL=https://marshaligndental.com

# Clinic WhatsApp Enquiry Phone (Public identifier, numbers only with country code)
VITE_WA_PHONE=919025655627

# Optional: Google Analytics / Tag Manager Measurement ID (Public Client ID)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Maps JavaScript API Key (If switching from embed iframe to Maps JS SDK)
# Note: Restrict this key in Google Cloud Console by HTTP referrer (marshaligndental.com/*)
# VITE_GOOGLE_MAPS_API_KEY=your_restricted_maps_api_key_here
